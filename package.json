{
  "name": "clueless",
  "private": true,
  "packageManager": "bun@1.1.38",
  "workspaces": ["frontend", "worker"],
  "scripts": {
    "dev": "bun --filter @clueless/frontend dev & bun --filter @clueless/worker dev",
    "build": "bun --filter @clueless/frontend build && bun --filter @clueless/worker build",
    "lint": "bun --filter @clueless/frontend lint"
  }
}
